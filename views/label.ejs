<style>
    .label-container{
        width: 100%;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 10px;
    }

    .label{
      width: 30%;
      height: 2.2cm;
      /* text-align: center; */
      border: 1px solid black;
      padding: 10px;
    }

    .label-header{
      font-size: 16px;
      margin:10px ;
    }

    .label-table{
      width: 200px;
      border: 1px solid black;
      border-collapse: collapse;
      margin-top: 10px;
    }
    .label table tr,td,th{
      padding: 5px;
      text-align: center;
      border: 1px solid black;
      

    }


</style>
</head>
<body>
  <div class="label-container">
    <!-- Dynamically generated labels will be injected here -->
     
    <%- labels %>

    <!-- Use <%- %> to render the raw HTML -->
  </div>
</body>
