<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Produktionsauftragübersicht</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 900px;
      margin: 40px auto;
      padding: 30px;
      font-family: Arial, sans-serif;
      box-sizing: border-box;
    }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
    }

    .left .p1 {
      color: black(0, 0, 0);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    .left .p2 {
      font-size: 14px;
      line-height: 22px;
    }

    .right img {
      max-width: 150px;
      margin-top: 5px;
    }

    .order-details {
      margin-top: 20px;
    }

    .order-details h3 {
      font-size: 20px;
      margin-bottom: 10px;
      text-decoration: underline;
    }

    .order-details h4 span {
      font-weight: normal;
    }

    .sub {
      margin-top: 10px;
      font-size: 15px;
    }

    .product {
      margin-top: 30px;
    }

    .product h2 {
      margin-bottom: 15px;
    }

    .product table {
      width: 100%;
      border-collapse: collapse;
      text-align: center;
    }

    .product th,
    .product td {
      padding: 10px;
      border: 1px solid black;
    }

    .thankyou {
      margin-top: 50px;
    }

    .thankyou h4 {
      margin: 10px 0;
      font-size: 16px;
    }

    .footer-note {
      font-size: 14px;
      color: #555;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="nav">
      <div class="left">
        <p class="p1">Frisch für Sie | Lindenhorster Str. 213 | 44339 Dortmund</p>
        <p class="p2">
          <strong style="font-size: 16px; color: black;">Bäckerei Vorwerk</strong><br />
          Höfkerstraße 38<br />
          44149 Dortmund
        </p>
      </div>
      <div class="right">
        <img src="http://localhost:4001/static/images/logo-fri.png" alt="Logo" />
      </div>
    </div>

    <div class="order-details">
      <h3>Lieferdetails</h3>
      <h4>Bestelldatum: <span><%= date %></span></h4>
    </div>

    <div class="sub">
      <p>Wir bedanken uns für die gute Zusammenarbeit.</p>
    </div>

    <div class="product">
      <h2>Produktionsauftragübersicht</h2>
      <table>
        <thead>
          <tr>
            <th>Pos.</th>
            <th>Produktname</th>
            <th>Bestellmenge</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= product.product_name %></td>
              <td><%= product.total_quantity %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="thankyou">
      <h4>Mit freundlichen Grüßen</h4>
      <p style="color: black;">Ihr Frisch für Sie Team</p>
      <p class="footer-note">Maschinell erstellte Schreiben sind auch ohne Unterschrift gültig.</p>
    </div>
  </div>
</body>
</html>
